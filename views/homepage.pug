doctype html
html(lang="en")
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet" href="/css/style.css")
    body
        main
            h1 Plants
            p
                a(href="/update-cobj") Add to this table
            table
                thead
                    tr
                        th Name
                        th Species
                        th Light level
                tbody
                    each plant in data
                        tr
                            td= plant.properties.name
                            td= plant.properties.species
                            td= plant.properties.light_level
                    else
                        tr
                            td(colspan="3") No plants yet. Add your first plant using the link above.
